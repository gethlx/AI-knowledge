"""深查：正文内所有编号出现处，核对其所附概念名是否与目标卡一致；并核查字段完整性。"""
import re, json
from collections import Counter, defaultdict

D = "/Users/larry/WorkBuddy/2026-09-13-14-09-47/02_分析产物/"
cards = json.load(open(D + "cards.json", encoding="utf-8"))
byid = {c["id"]: c for c in cards}
ids = set(byid)

def refs(s):
    return re.findall(r"\d+-\d+", s or "")

print("=" * 78)
print("【1】正文内「编号 + 概念名」配对一致性核查")
print("    规则：捕获 '编号' 后紧跟的「」或引号内的名称，或 '编号 名称' 形式，比对目标卡名称。")
pat = re.compile(r"(\d+-\d+)\s*[「\"'“]?\s*([\u4e00-\u9fa5A-Za-z0-9（）()·\-]{2,20}?)\s*[」\"'”]?\s*[（(]?(?:互引|见)?")
suspect = []
for c in cards:
    for k, v in c["fields"].items():
        for m in re.finditer(r"(\d+-\d+)\s*[「“]([^」”]{2,24})[」”]", v):
            rid, nm = m.group(1), m.group(2)
            if rid not in ids: 
                suspect.append((c["id"], k, rid, nm, "目标编号不存在")); continue
            tgt = byid[rid]["name"]
            if nm and (nm not in tgt and tgt not in nm):
                suspect.append((c["id"], k, rid, nm, f"名称不符，实际={tgt}"))
        # 「与 X-YY 互引」形式
        for m in re.finditer(r"与\s*(\d+-\d+)\s*[「“]([^」”]{2,24})[」”]", v):
            rid, nm = m.group(1), m.group(2)
            if rid not in ids:
                suspect.append((c["id"], k, rid, nm, "目标编号不存在")); continue
            tgt = byid[rid]["name"]
            if nm not in tgt and tgt not in nm:
                suspect.append((c["id"], k, rid, nm, f"名称不符，实际={tgt}"))
print(f"  可疑 {len(suspect)} 处：")
for s in suspect:
    print(f"    {s[0]} [{s[1]}] 引用 {s[2]}「{s[3]}」 → {s[4]}")

print()
print("=" * 78)
print("【2】字段完整性：来源依据为「—」或空 / 深度上限为空的卡")
for c in cards:
    miss = [k for k in ("精确定义","深度上限","来源依据","前置概念","后续概念") if not c["fields"].get(k,"").strip()]
    if miss:
        print(f"    {c['id']} {c['name']} 缺字段：{miss}")
